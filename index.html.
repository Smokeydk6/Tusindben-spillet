<!doctype html>
<html lang="da">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<meta name="theme-color" content="#173c27">
<title>Tusindben-kaos</title>
<style>
:root{--green:#173c27;--lime:#b8f34a;--cream:#fff3d1;--orange:#ff7a35}
*{box-sizing:border-box}
body{margin:0;min-height:100dvh;background:radial-gradient(circle at top,#39794a,#10291d 70%);font-family:system-ui,-apple-system,sans-serif;color:var(--cream);display:flex;justify-content:center;overscroll-behavior:none}
.app{width:min(100%,560px);padding:14px 14px 22px;display:flex;flex-direction:column;gap:12px}
header{text-align:center}
h1{margin:2px 0 0;font-size:clamp(28px,8vw,44px);line-height:1;font-weight:1000;letter-spacing:-1px;color:#ffcc35;text-shadow:3px 4px 0 #b64221,5px 6px 0 #142c1c}
.sub{font-size:13px;margin:8px 0;color:#d8f5bb}
.stats{display:flex;justify-content:space-between;gap:8px}
.pill{background:#10271c;border:2px solid #528b4a;border-radius:14px;padding:8px 12px;font-weight:800;flex:1;text-align:center}
.pill span{color:var(--lime)}
.gamebox{position:relative;border:4px solid #f4cf71;border-radius:20px;overflow:hidden;box-shadow:0 8px 0 #101f16;background:#80552c}
canvas{display:block;width:100%;height:auto;touch-action:none}
.overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:22px;background:#10271cbb;text-align:center}
.panel{background:#fff1c9;color:#203521;border:4px solid #f6bd45;border-radius:22px;padding:22px 18px;max-width:300px;box-shadow:0 7px 0 #9b4b27}
.panel h2{font-size:28px;margin:0 0 8px;color:#d64f20}
.panel p{margin:6px 0 15px;line-height:1.4}
button{border:0;border-radius:14px;background:linear-gradient(#d2ff62,#8edb31);color:#17351e;font-weight:1000;font-size:18px;padding:13px 20px;box-shadow:0 4px 0 #4e8e24;touch-action:manipulation}
button:active{transform:translateY(2px);box-shadow:0 2px 0 #4e8e24}
.help{text-align:center;font-size:13px;line-height:1.4;color:#e3f5d2}
.controls{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;width:min(100%,260px);margin:0 auto}
.controls button{padding:9px;font-size:23px;background:linear-gradient(#fff0b2,#ffc64c);box-shadow:0 4px 0 #9b6420}
.controls .empty{visibility:hidden}
footer{text-align:center;font-size:11px;color:#b7d6b0}
</style>
</head>
<body>
<div class="app">
<header><h1>🐛 TUSINDBEN-KAOS</h1><p class="sub">Saml snacks. Bliv længere. Pas på stenene!</p></header>
<div class="stats"><div class="pill">⭐ Point: <span id="score">0</span></div><div class="pill">🐛 Længde: <span id="length">3</span></div><div class="pill">🏆 Rekord: <span id="best">0</span></div></div>
<div class="gamebox">
<canvas id="game" width="360" height="520" aria-label="Tusindben-spillebane"></canvas>
<div class="overlay" id="overlay"><div class="panel"><h2>Er du klar?!</h2><p>Styr dit fjollede tusindben, spis de gyldne snacks og undgå stenene.</p><button id="start">START SPILLET 🚀</button></div></div>
</div>
<div class="help">👆 Stryg på banen eller brug knapperne til at dreje.<br>Du kan også dreje ved at trykke hurtigt i en retning.</div>
<div class="controls" aria-label="Styring"><span class="empty"></span><button data-dir="up" aria-label="Op">⬆️</button><span class="empty"></span><button data-dir="left" aria-label="Venstre">⬅️</button><button data-dir="down" aria-label="Ned">⬇️</button><button data-dir="right" aria-label="Højre">➡️</button></div>
<footer>Første version • Gem rekorden på denne enhed</footer>
</div>
<script>
(() => {
const canvas=document.getElementById('game'),ctx=canvas.getContext('2d');
const scoreEl=document.getElementById('score'),lengthEl=document.getElementById('length'),bestEl=document.getElementById('best'),overlay=document.getElementById('overlay');
let best=Number(localStorage.getItem('tusindbenBest')||0);bestEl.textContent=best;
const cell=20, cols=18, rows=26;
let worm,dir,nextDir,food,rocks,score,running=false,loop=null,tick=0;
const dirs={up:{x:0,y:-1},down:{x:0,y:1},left:{x:-1,y:0},right:{x:1,y:0}};
function randPos(){return {x:Math.floor(Math.random()*cols),y:Math.floor(Math.random()*rows)}}
function occupied(p){return worm.some(s=>s.x===p.x&&s.y===p.y)||rocks.some(s=>s.x===p.x&&s.y===p.y)}
function newFood(){let p;do{p=randPos()}while(occupied(p));return p}
function reset(){worm=[{x:8,y:13},{x:7,y:13},{x:6,y:13}];dir='right';nextDir='right';score=0;rocks=[];for(let i=0;i<8;i++){let p;do{p=randPos()}while(worm.some(s=>s.x===p.x&&s.y===p.y)||rocks.some(s=>s.x===p.x&&s.y===p.y));rocks.push(p)}food=newFood();updateStats();draw()}
function updateStats(){scoreEl.textContent=score;lengthEl.textContent=worm.length;bestEl.textContent=best}
function roundRect(x,y,w,h,r){ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fill()}
function draw(){
 ctx.clearRect(0,0,360,520);ctx.fillStyle='#9b6a37';ctx.fillRect(0,0,360,520);
 for(let y=0;y<rows;y++)for(let x=0;x<cols;x++){if((x+y)%2===0){ctx.fillStyle='#a8763d';ctx.fillRect(x*cell,y*cell,cell,cell)}}
 // små græspletter
 for(let i=0;i<32;i++){let x=(i*47+13)%350,y=(i*73+29)%510;ctx.fillStyle='#5c9b45';ctx.beginPath();ctx.ellipse(x,y,3,7,-.5,0,Math.PI*2);ctx.fill()}
 rocks.forEach(r=>{ctx.fillStyle='#60472f';roundRect(r.x*cell+2,r.y*cell+4,17,14,5);ctx.fillStyle='#a7a69a';roundRect(r.x*cell+2,r.y*cell+1,16,14,6);ctx.fillStyle='#c9c8b7';ctx.beginPath();ctx.arc(r.x*cell+7,r.y*cell+5,3,0,Math.PI*2);ctx.fill()});
 // snacks
 ctx.fillStyle='#ffe94e';ctx.beginPath();ctx.arc(food.x*cell+10,food.y*cell+10,8,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#fff7ad';ctx.lineWidth=2;ctx.stroke();
 ctx.fillStyle='#ffb92d';ctx.beginPath();ctx.arc(food.x*cell+8,food.y*cell+7,2,0,Math.PI*2);ctx.fill();
 worm.slice().reverse().forEach((s,i)=>{let head=i===worm.length-1;let rad=head?9:8;ctx.fillStyle=head?'#ff5b36':['#ffcc36','#57d8df','#a7ed48','#b879ff'][i%4];ctx.beginPath();ctx.arc(s.x*cell+10,s.y*cell+10,rad,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#633a2a';ctx.lineWidth=1.5;ctx.stroke();if(head){ctx.strokeStyle='#633a2a';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(s.x*cell+6,s.y*cell+4);ctx.lineTo(s.x*cell+4,s.y*cell-1);ctx.moveTo(s.x*cell+14,s.y*cell+4);ctx.lineTo(s.x*cell+16,s.y*cell-1);ctx.stroke();ctx.fillStyle='white';ctx.beginPath();ctx.arc(s.x*cell+7,s.y*cell+8,3.5,0,Math.PI*2);ctx.arc(s.x*cell+13,s.y*cell+8,3.5,0,Math.PI*2);ctx.fill();ctx.fillStyle='#192a1c';ctx.beginPath();ctx.arc(s.x*cell+8,s.y*cell+8,1.5,0,Math.PI*2);ctx.arc(s.x*cell+14,s.y*cell+8,1.5,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#7a2018';ctx.beginPath();ctx.arc(s.x*cell+10,s.y*cell+12,3,0,Math.PI);ctx.stroke()}})}
function setDir(d){if(!running)return;let a=dirs[d],b=dirs[dir];if(a.x===-b.x&&a.y===-b.y)return;nextDir=d}
function endGame(){running=false;clearInterval(loop);if(score>best){best=score;localStorage.setItem('tusindbenBest',best)}updateStats();overlay.style.display='flex';overlay.querySelector('.panel').innerHTML=`<h2>AV AV! 💥</h2><p>Du fik <b>${score} point</b> og nåede længde <b>${worm.length}</b>.<br>Rekord: <b>${best}</b></p><button id="start">PRØV IGEN 🔁</button>`;document.getElementById('start').addEventListener('click',start)}
function step(){dir=nextDir;const d=dirs[dir],head={x:worm[0].x+d.x,y:worm[0].y+d.y};if(head.x<0||head.x>=cols||head.y<0||head.y>=rows||rocks.some(r=>r.x===head.x&&r.y===head.y)||worm.slice(0,-1).some(s=>s.x===head.x&&s.y===head.y)){endGame();return}worm.unshift(head);if(head.x===food.x&&head.y===food.y){score+=10;food=newFood()}else worm.pop();updateStats();draw()}
function start(){reset();overlay.style.display='none';running=true;clearInterval(loop);loop=setInterval(step,135)}
document.getElementById('start').addEventListener('click',start);
document.querySelectorAll('[data-dir]').forEach(b=>b.addEventListener('click',()=>setDir(b.dataset.dir)));
let touch=null;canvas.addEventListener('touchstart',e=>{let t=e.changedTouches[0];touch={x:t.clientX,y:t.clientY}},{passive:true});
canvas.addEventListener('touchend',e=>{if(!touch)return;let t=e.changedTouches[0],dx=t.clientX-touch.x,dy=t.clientY-touch.y;if(Math.max(Math.abs(dx),Math.abs(dy))>15)setDir(Math.abs(dx)>Math.abs(dy)?(dx>0?'right':'left'):(dy>0?'down':'up'));touch=null},{passive:true});
window.addEventListener('keydown',e=>{const m={ArrowUp:'up',w:'up',ArrowDown:'down',s:'down',ArrowLeft:'left',a:'left',ArrowRight:'right',d:'right'};if(m[e.key]){e.preventDefault();setDir(m[e.key])}});
reset();
})();
</script>
</body>
</html>